# Copy to .env for local work. On Render / Railway set these in the dashboard.
# NEVER commit the real .env file.

# ---- Database ----
# Production: paste the connection string from Neon / Render / Railway
DATABASE_URL=postgresql://user:password@host/dbname
# Local Postgres instead of a URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=naturesoul
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
# No Postgres installed? Use a local file database:
# DB_DIALECT=sqlite

# Run once after changing a model, then remove it
# DB_SYNC=alter

# ---- Website ----
# Comma separated list of sites allowed to call this API
ALLOWED_ORIGINS=https://kejit80888752.github.io,http://localhost:5174

# ---- Admin ----
# Long random string. Required to read bookings (/api/admin/bookings).
ADMIN_KEY=

# ---- Email (optional) ----
# Gmail: enable 2-step verification, then create an App Password
EMAIL_USER=
EMAIL_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Resort's own copy of every booking
OWNER_EMAIL=

# ---- reCAPTCHA (optional) ----
# When set, the booking API rejects requests without a valid captcha token
RECAPTCHA_SECRET=

PORT=5000
